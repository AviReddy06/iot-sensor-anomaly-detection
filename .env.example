# Copy this file to `.env` (already in .gitignore) and fill in the channels you want to use.

# 1. Recommended: ntfy.sh mobile & browser push (no account or API key required)
# Pick a unique hard-to-guess topic name, then subscribe in the free ntfy app or https://ntfy.sh/<topic>
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# 2. Optional: Slack, Discord, or Microsoft Teams Incoming Webhook URL
ALERT_WEBHOOK_URL=

# 3. Optional: Email broadcast via SMTP (e.g. Gmail App Password -> all-employees@company.com)
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_PASSWORD=
# Comma-separated list of employee or distribution-list email addresses
ALERT_EMAIL_TO=
