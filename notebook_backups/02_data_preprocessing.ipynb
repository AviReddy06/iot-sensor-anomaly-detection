   "source": [
    "# Get the anomaly window from test_labels\n",
    "label_start = test_labels[\"start\"].iloc[0]\n",
    "label_end = test_labels[\"end\"].iloc[0]\n",
    "\n",
    "print(\"=== TEST DATA PREPARATION ===\")\n",
    "print(f\"Test rows: {len(test)}\")\n",
    "print(f\"Label window: {label_start} to {label_end}\")\n",
    "\n",
    "# Create row-level labels\n",
    "# For each test row, check if timestamp falls within anomaly window\n",
    "test_labeled = test.copy()\n",
    "test_labeled[\"label\"] = 0  # Default: normal\n",
    "\n",
    "# Rows within anomaly window get label = 1\n",
    "anomaly_mask = (test_labeled[\"timestamp\"] >= label_start) & (test_labeled[\"timestamp\"] <= label_end)\n",
    "test_labeled.loc[anomaly_mask, \"label\"] = 1\n",
    "\n",
    "anomaly_count = anomaly_mask.sum()\n",
    "normal_count = len(test_labeled) - anomaly_count\n",
    \n",
    "print(\"\\n=== ROW-LEVEL LABEL CREATION ===\")\n",
    "print(f\"Rows in anomaly window: {anomaly_count}\")\n",
    "print(f\"Rows outside window (normal): {normal_count}\")\n",
    "print(\"Label distribution:\")\n",
    "print(test_labeled[\"label\"].value_counts())\n",
    "\n",
    "# Verify against EDA expectation\n",
    "expected_anomaly = 10\n",
    "if anomaly_count == expected_anomaly:\n",
    "    print(f\"\\nVerification: EDA expected {expected_anomaly} anomaly rows. Match: ✓\")\n",
    "else:\n",
    "    print(f\"\\n⚠️ DISCREPANCY: EDA expected {expected_anomaly} anomaly rows, got {anomaly_count}\")\n",
    "    print(\"Investigate the timestamp boundaries.\")\n",
    "\n",
    "# Show the anomaly rows\n",
    "print(\"\\nAnomaly rows (label=1):\")\n",
    "anomaly_rows = test_labeled[test_labeled[\"label\"] == 1]\n",
    "print(anomaly_rows[['timestamp', 'temperature', 'humidity', 'label']])\n",
    "\n",
    "# Save test data with labels\n",
