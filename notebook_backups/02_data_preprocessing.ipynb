    "test_bad_temp = test[(test[\"temperature\"] < 0) | (test[\"temperature\"] > 50)]\n",
    "test_bad_hum = test[(test[\"humidity\"] < 20) | (test[\"humidity\"] > 90)]\n",
    "print(f\"Test - temp outside 0-50°C: {len(test_bad_temp)}\")\n",
    "print(f\"Test - humidity outside 20-90%: {len(test_bad_hum)}\")\n",
