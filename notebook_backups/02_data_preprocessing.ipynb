    "test_labels = pd.read_csv(raw_dir / \"test_labels.csv\")\n",
    "\n",
    "# Quick verification\n",
    "print(\"=== NORMAL DATA (no header) ===\")\n",
    "print(f\"Shape: {normal.shape}\")\n",
