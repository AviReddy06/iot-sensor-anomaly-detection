      "Columns: ['timestamp', 'temperature', 'humidity']\n",
      "First 3 rows:\n",
      "             timestamp  temperature  humidity\n",
      "0  2026-10-29T16:39:00         25.8      60.7\n",
      "1  2026-10-29T16:39:02         25.8      60.1\n",
      "2  2026-10-29T16:39:04         25.8      59.4\n",
      "\n",
      "=== PILOT DATA (has header) ===\n",
      "Shape: (3087, 3)\n",
      "Columns: ['timestamp', 'temperature', 'humidity']\n",
      "First 3 rows:\n",
      "             timestamp  temperature  humidity\n",
      "0  2026-10-27T22:02:14         26.2      59.4\n",
      "1  2026-10-27T22:02:16         26.3      59.3\n",
      "2  2026-10-27T22:02:18         26.2      59.4\n",
      "\n",
      "=== TEST DATA (has header) ===\n",
      "Shape: (56, 3)\n",
      "Columns: ['timestamp', 'temperature', 'humidity']\n",
      "First 3 rows:\n",
      "             timestamp  temperature  humidity\n",
      "0  2026-10-27T22:02:14         25.8      59.4\n",
      "1  2026-10-27T22:02:16         26.3      59.3\n",
      "2  2026-10-27T22:02:18         26.2      59.4\n",
      "\n",
