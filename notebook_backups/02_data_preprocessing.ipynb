   "source": [
    "# Look at the last rows of the deduplicated data\n",
    "print(\"=== SUSPICIOUS TAIL INVESTIGATION ===\")\n",
    "print(\"Last 15 rows of deduplicated data:\")\n",
    "print(normal_dedup.tail(15))\n",
    "\n",
