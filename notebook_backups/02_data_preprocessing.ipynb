      "\n",
      "Pilot data:\n",
      "timestamp      0\n",
      "temperature    0\n",
      "humidity       0\n",
      "dtype: int64\n",
      "\n",
      "Test data:\n",
      "timestamp      0\n",
      "temperature    0\n",
      "humidity       0\n",
      "dtype: int64\n",
      "\n",
      "=== DHT11 RANGE CHECK ===\n",
      "Normal - temp outside 0-50°C: 0\n",
      "Normal - humidity outside 20-90%: 13\n",
      "Pilot - temp outside 0-50°C: 0\n",
      "Pilot - humidity outside 20-90%: 27\n",
      "Test - temp outside 0-50°C: 0\n",
      "Test - humidity outside 20-90%: 0\n"
     ]
    }
   ],
   "source": [
    "# Check missing values\n",
    "print(\"=== MISSING VALUES ===\")\n",
