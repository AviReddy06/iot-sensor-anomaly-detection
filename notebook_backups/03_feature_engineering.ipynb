      "1         25.8      60.1                  NaN                 NaN                   NaN                  NaN\n",
      "2         25.8      59.4                  NaN                 NaN                   NaN                  NaN\n",
      "3         25.7      58.6                  NaN                 NaN                   NaN                  NaN\n",
      "4         25.7      57.7               25.76                0.05                   NaN                  NaN\n",
      "5         25.7      57.2               25.74                0.05                   NaN                  NaN\n",
      "6         25.6      56.9               25.70                0.08                   NaN                  NaN\n",
      "7         25.6      56.7               25.68                0.08                   NaN                  NaN\n",
      "8         25.6      56.6               25.64                0.08                   NaN                  NaN\n",
      "9         25.5      56.3               25.64                0.05                   NaN                  NaN"
     ]
