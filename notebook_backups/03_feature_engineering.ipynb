   ],
   "source": [
    "def add_gap_aware_rolling(df):\n",
    "    \"\"\"Compute rolling mean/std within each session (groupby session_id).\"\"\"\n",
    "    df = df.copy()\n",
    "    \n",
    "    # Window 5\n",
    "    df[\"temp_rolling_mean_5\"] = df.groupby(\"session_id\")[\"temperature\"].transform(lambda x: x.rolling(window=5).mean())\n",
    "    df[\"temp_rolling_std_5\"] = df.groupby(\"session_id\")[\"temperature\"].transform(lambda x: x.rolling(window=5).std())\n",
    "    df[\"hum_rolling_mean_5\"] = df.groupby(\"session_id\")[\"humidity\"].transform(lambda x: x.rolling(window=5).mean())\n",
    "    df[\"hum_rolling_std_5\"] = df.groupby(\"session_id\")[\"humidity\"].transform(lambda x: x.rolling(window=5).std())\n",
    "    \n",
    "    # Window 15\n",
    "    df[\"temp_rolling_mean_15\"] = df.groupby(\"session_id\")[\"temperature\"].transform(lambda x: x.rolling(window=15).mean())\n",
    "    df[\"temp_rolling_std_15\"] = df.groupby(\"session_id\")[\"temperature\"].transform(lambda x: x.rolling(window=15).std())\n",
    "    df[\"hum_rolling_mean_15\"] = df.groupby(\"session_id\")[\"humidity\"].transform(lambda x: x.rolling(window=15).mean())\n",
    "    df[\"hum_rolling_std_15\"] = df.groupby(\"session_id\")[\"humidity\"].transform(lambda x: x.rolling(window=15).std())\n",
    "    \n",
    "    return df\n",
    "\n",
    "normal = add_gap_aware_rolling(normal)\n",
    "pilot = add_gap_aware_rolling(pilot)\n",
    "test = add_gap_aware_rolling(test)\n",
    "\n",
    "for name, df in [(\"normal\", normal), (\"pilot\", pilot), (\"test\", test)]:\n",
    "    print(f\"=== GAP-AWARE ROLLING FEATURES ({name.upper()}) ===\")\n",
    "    for col in [\"temp_rolling_mean_5\", \"temp_rolling_std_5\", \"hum_rolling_mean_5\", \"hum_rolling_std_5\",\n",
    "                \"temp_rolling_mean_15\", \"temp_rolling_std_15\", \"hum_rolling_mean_15\", \"hum_rolling_std_15\"]:\n",
    "        print(f\"{col} NaN: {df[col].isna().sum()}\")\n",
    "    print()\n",
    "    \n",
    "# Show rows across a session boundary\n",
    "print(\"Sample rows across session boundary (normal):\")\n",
    "cols = [\"session_id\", \"temperature\", \"humidity\", \"temp_rolling_mean_5\", \"temp_rolling_std_5\"]\n",
    print(normal[cols].iloc[14228:14238])
   ]
