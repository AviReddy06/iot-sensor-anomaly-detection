    "def add_change_features(df):\n",
    "    \"\"\"Add change and absolute change features for temperature and humidity.\"\"\"\n",
    "    df = df.copy()\n",
    "    df[\"temperature_change\"] = df[\"temperature\"].diff()\n",
    "    df[\"humidity_change\"] = df[\"humidity\"].diff()\n",
    "    df[\"temperature_abs_change\"] = df[\"temperature_change\"].abs()\n",
    "    df[\"humidity_abs_change\"] = df[\"humidity_change\"].abs()\n",
    "    return df\n",
    "\n",
    "normal = add_change_features(normal)\n",
    "pilot = add_change_features(pilot)\n",
    "test = add_change_features(test)\n",
    "\n",
    "for name, df in [(\"normal\", normal), (\"pilot\", pilot), (\"test\", test)]:\n",
    "    print(f\"=== {name.upper()} CHANGE FEATURES ===\")\n",
    "    print(f\"temperature_change range: {df['temperature_change'].min()} to {df['temperature_change'].max()}\")\n",
    "    print(f\"temperature_change NaN count: {df['temperature_change'].isna().sum()}\")\n",
    "    print(f\"temperature_abs_change range: {df['temperature_abs_change'].min()} to {df['temperature_abs_change'].max()}\")\n",
    "    print(f\"humidity_change range: {df['humidity_change'].min()} to {df['humidity_change'].max()}\")\n",
    "    print(f\"humidity_change NaN count: {df['humidity_change'].isna().sum()}\")\n",
    "    print(f\"humidity_abs_change range: {df['humidity_abs_change'].min()} to {df['humidity_abs_change'].max()}\")\n",
    "    print()\n",
    "    \n",
    "print(\"First 5 rows (normal):\")\n",
    "print(normal[[\"temperature\", \"humidity\", \"temperature_change\", \"temperature_abs_change\", \"humidity_change\", \"humidity_abs_change\"]].head())"
   ]
