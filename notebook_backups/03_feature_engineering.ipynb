   "source": [
    "def add_rolling_features(df):\n",
    "    \"\"\"Add rolling mean and std for temperature and humidity with windows 5 and 15.\"\"\"\n",
    "    df = df.copy()\n",
    "    \n",
    "    # Window size 5\n",
    "    df[\"temp_rolling_mean_5\"] = df[\"temperature\"].rolling(window=5).mean()\n",
    "    df[\"temp_rolling_std_5\"] = df[\"temperature\"].rolling(window=5).std()\n",
    "    df[\"hum_rolling_mean_5\"] = df[\"humidity\"].rolling(window=5).mean()\n",
    "    df[\"hum_rolling_std_5\"] = df[\"humidity\"].rolling(window=5).std()\n",
    "    \n",
    "    # Window size 15\n",
    "    df[\"temp_rolling_mean_15\"] = df[\"temperature\"].rolling(window=15).mean()\n",
    "    df[\"temp_rolling_std_15\"] = df[\"temperature\"].rolling(window=15).std()\n",
    "    df[\"hum_rolling_mean_15\"] = df[\"humidity\"].rolling(window=15).mean()\n",
    "    df[\"hum_rolling_std_15\"] = df[\"humidity\"].rolling(window=15).std()\n",
    "    \n",
    "    return df\n",
    "\n",
    "normal = add_rolling_features(normal)\n",
    "pilot = add_rolling_features(pilot)\n",
    "test = add_rolling_features(test)\n",
    "\n",
    "for name, df in [(\"normal\", normal), (\"pilot\", pilot), (\"test\", test)]:\n",
    "    print(f\"=== {name.upper()} ROLLING FEATURES ===\")\n",
    "    for col in [\"temp_rolling_mean_5\", \"temp_rolling_std_5\", \"hum_rolling_mean_5\", \"hum_rolling_std_5\",\n",
    "                \"temp_rolling_mean_15\", \"temp_rolling_std_15\", \"hum_rolling_mean_15\", \"hum_rolling_std_15\"]:\n",
    "        print(f\"{col} NaN: {df[col].isna().sum()}\")\n",
    "    print()\n",
    "    \n",
    "print(\"First 10 rows (normal):\")\n",
    "cols = [\"temperature\", \"humidity\", \"temp_rolling_mean_5\", \"temp_rolling_std_5\",\n",
    "        \"temp_rolling_mean_15\", \"temp_rolling_std_15\"]\n",
    "print(normal[cols].head(10))"
   ]
