   ],
   "source": [
    "def analyze_gaps(df, name):\n",
    "    \"\"\"Print gap statistics for a dataset.\"\"\"\n",
    "    df = df.copy()\n",
    "    df[\"time_diff\"] = df[\"timestamp\"].diff().dt.total_seconds()\n",
    "    large_gaps = df[df[\"time_diff\"] > 10]\n",
    "    print(f\"=== GAP ANALYSIS ({name.upper()}) ===\")\n",
    "    print(f\"Total intervals: {len(df['time_diff'].dropna())}\")\n",
    "    print(f\"Intervals > 10 seconds: {len(large_gaps)}\")\n",
    "    if len(large_gaps) > 0:\n",
    "        print(\"Largest gaps:\")\n",
    "        print(large_gaps[\"time_diff\"].nlargest(10).values)\n",
    "    return df[\"time_diff\"]\n",
    "\n",
    "normal_diff = analyze_gaps(normal, \"normal\")\n",
    "pilot_diff = analyze_gaps(pilot, \"pilot\")\n",
    "test_diff = analyze_gaps(test, \"test\")\n",
    "\n",
    "# Create session IDs based on gaps > 10 seconds\n",
    "def add_session_id(df):\n",
    "    df = df.copy()\n",
    "    df[\"time_diff\"] = df[\"timestamp\"].diff().dt.total_seconds()\n",
    "    # Gap > 10 seconds starts new session\n",
    "    df[\"session_id\"] = (df[\"time_diff\"] > 10).cumsum()\n",
    "    # Fill first row (NaN time_diff) with session 0\n",
    "    df[\"session_id\"] = df[\"session_id\"].fillna(0).astype(int)\n",
    "    return df\n",
    "\n",
    "normal = add_session_id(normal)\n",
    "pilot = add_session_id(pilot)\n",
    "test = add_session_id(test)\n",
    "\n",
    "for name, df in [(\"normal\", normal), (\"pilot\", pilot), (\"test\", test)]:\n",
    "    sessions = df[\"session_id\"].value_counts().sort_index()\n",
    "    print(f\"Session counts ({name}): \" + str(dict(sessions)))"
   ]
  },
