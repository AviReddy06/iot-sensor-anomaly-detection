      "14229         0         25.8      58.1               25.78                0.04\n",
      "14230         0         25.8      58.0               25.78                0.04\n",
      "14231         0         25.8      57.9               25.80                0.00\n",
      "14232         1         25.7      57.8                NaN                 NaN\n",
      "14233         1         25.7      57.7                NaN                 NaN\n",
