      "temp_rolling_mean_5 NaN: 4\n",
      "temp_rolling_std_5 NaN: 4\n",
      "hum_rolling_mean_5 NaN: 4\n",
      "hum_rolling_std_5 NaN: 4\n",
      "temp_rolling_mean_15 NaN: 14\n",
      "temp_rolling_std_15 NaN: 14\n",
